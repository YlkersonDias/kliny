{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=kliny;User=kliny_app;"
  },
  "Jwt": {
    "Issuer": "Kliny",
    "Audience": "Kliny",
    "ExpirationMinutes": 60
  },
  "RateLimits": {
    "LoginPerIp": { "PermitLimit": 10, "WindowSeconds": 60 },
    "RegisterPerIp": { "PermitLimit": 5, "WindowSeconds": 3600 },
    "LoginPerEmail": { "MaxFailures": 5, "WindowMinutes": 15, "LockoutMinutes": 15 }
  }
}
