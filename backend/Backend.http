@baseUrl = http://localhost:5228
@token = cole_aqui_o_token_devolvido_no_cadastro_ou_login

### Cadastro (201)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Usuário Teste",
  "email": "teste@kliny.local",
  "password": "senha12345"
}

### Cadastro com e-mail repetido (409)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Outro Usuário",
  "email": "  TESTE@kliny.local ",
  "password": "senha12345"
}

### Cadastro inválido (400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "nao-e-email",
  "password": "curta"
}

### Login correto (200)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "teste@kliny.local",
  "password": "senha12345"
}

### Login com senha errada (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "teste@kliny.local",
  "password": "senhaerrada"
}

### Usuário logado (200)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Usuário logado sem token (401)
GET {{baseUrl}}/api/auth/me

############################## Categorias ##############################

### Listar categorias (200)
GET {{baseUrl}}/api/categories
Authorization: Bearer {{token}}

### Criar categoria (201)
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Alimentação"
}

### Criar categoria com nome repetido, ignorando maiúsculas e acentos (409)
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "alimentacao"
}

### Renomear categoria (200)
PUT {{baseUrl}}/api/categories/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mercado"
}

### Apagar categoria; as movimentações dela ficam sem categoria (204)
DELETE {{baseUrl}}/api/categories/1
Authorization: Bearer {{token}}

############################ Movimentações #############################

### Criar receita (201)
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Salário",
  "amount": 3500.00,
  "date": "2026-10-01"
}

### Criar gasto com categoria (201)
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Compras do mês",
  "amount": -420.75,
  "date": "2026-10-02",
  "categoryId": 1
}

### Criar movimentação inválida: valor zero (400)
POST {{baseUrl}}/api/transactions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Inválida",
  "amount": 0,
  "date": "2026-10-02"
}

### Listar com filtros e paginação (200)
# type: income, expense ou vault
GET {{baseUrl}}/api/transactions?from=2026-10-01&to=2026-10-31&type=expense&page=1&pageSize=20
Authorization: Bearer {{token}}

### Só receitas e gastos sem categoria (200); com categoryId ou type=vault responde 400
GET {{baseUrl}}/api/transactions?uncategorized=true
Authorization: Bearer {{token}}

### Detalhe (200)
GET {{baseUrl}}/api/transactions/1
Authorization: Bearer {{token}}

### Atualizar (200)
PUT {{baseUrl}}/api/transactions/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Salário de outubro",
  "amount": 3600.00,
  "date": "2026-10-01"
}

### Apagar (204)
DELETE {{baseUrl}}/api/transactions/1
Authorization: Bearer {{token}}

################################ Cofres ################################

### Listar cofres com saldo (200)
GET {{baseUrl}}/api/vaults
Authorization: Bearer {{token}}

### Criar cofre (201)
POST {{baseUrl}}/api/vaults
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Reserva de emergência",
  "goal": 10000.00
}

### Detalhe com saldo (200)
GET {{baseUrl}}/api/vaults/1
Authorization: Bearer {{token}}

### Alterar nome e meta (200)
PUT {{baseUrl}}/api/vaults/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Reserva",
  "goal": 12000.00
}

### Depositar; o valor é sempre positivo (200)
POST {{baseUrl}}/api/vaults/1/deposit
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 500.00,
  "date": "2026-10-02"
}

### Retirar (200, ou 400 se passar do saldo)
POST {{baseUrl}}/api/vaults/1/withdraw
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 150.00,
  "date": "2026-10-03",
  "description": "Conserto do carro"
}

### Extrato do cofre (200)
GET {{baseUrl}}/api/transactions?vaultId=1
Authorization: Bearer {{token}}

### Apagar cofre: só com saldo zero, e apaga também as movimentações dele (204 ou 409)
DELETE {{baseUrl}}/api/vaults/1
Authorization: Bearer {{token}}

############################## Relatórios ##############################
# from e to são obrigatórios. Nos relatórios, expense vem POSITIVO.

### Resumo do período, com saldos no dia "to" (200)
GET {{baseUrl}}/api/reports/summary?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{token}}

### Gastos por categoria (200); type=income para receitas
GET {{baseUrl}}/api/reports/by-category?from=2026-10-01&to=2026-10-31&type=expense
Authorization: Bearer {{token}}

### Linha do tempo por mês (200)
GET {{baseUrl}}/api/reports/timeline?from=2026-01-01&to=2026-12-31&groupBy=month
Authorization: Bearer {{token}}

### Linha do tempo por dia, até 366 dias (200)
GET {{baseUrl}}/api/reports/timeline?from=2026-10-01&to=2026-10-31&groupBy=day
Authorization: Bearer {{token}}

### Sem período (400)
GET {{baseUrl}}/api/reports/summary
Authorization: Bearer {{token}}
