# Modelo do deploy/.env (o .env de verdade fica fora do Git). Não preencha à mão: rode
# deploy/criar-segredos.ps1, que gera as senhas e a chave do JWT. Só o TUNNEL_TOKEN é colado
# por você, do painel da Cloudflare.
MYSQL_ROOT_PASSWORD=
KLINY_APP_PASSWORD=
KLINY_MIGRATOR_PASSWORD=
KLINY_BACKUP_PASSWORD=
JWT_KEY=
# Pasta do PC onde ficam os backups do banco (fora do repositório).
BACKUP_DIR=
# Opcional: pasta em outro disco para uma segunda cópia de cada backup (por exemplo, H:\Kliny-backups).
BACKUP_COPY_DIR=
TUNNEL_TOKEN=
# Chave da API do Resend (só envio, só do domínio kliny.app.br), para o e-mail de "Esqueci minha senha".
# Colada por você, do painel do Resend. Vazia, nenhum e-mail é enviado.
RESEND_API_KEY=
