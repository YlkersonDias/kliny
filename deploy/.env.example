# Não preencha à mão: rode deploy/criar-segredos.ps1. Só o TUNNEL_TOKEN é colado, do painel da Cloudflare.
MYSQL_ROOT_PASSWORD=
KLINY_APP_PASSWORD=
KLINY_MIGRATOR_PASSWORD=
KLINY_BACKUP_PASSWORD=
JWT_KEY=
# Pasta dos backups do banco (fora do repositório).
BACKUP_DIR=
# Opcional: pasta em outro disco para uma segunda cópia de cada backup.
BACKUP_COPY_DIR=
TUNNEL_TOKEN=
# Chave da API do Resend (só envio, só do domínio). Vazia, nenhum e-mail é enviado.
RESEND_API_KEY=
